<Window x:Class="PicasaRevive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="svacitra" Width="1366" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#151619"
        Icon="pack://application:,,,/Assets/app.ico">

    <Window.InputBindings>
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Close}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Close}" Executed="Exit_Click" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Dark menu bar that matches the web UI (see wwwroot/css/modern.css for the palette). -->
        <SolidColorBrush x:Key="MenuBar" Color="#1B1D21" />
        <SolidColorBrush x:Key="MenuPopup" Color="#24262B" />
        <SolidColorBrush x:Key="MenuHover" Color="#33373E" />
        <SolidColorBrush x:Key="MenuLine" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="MenuText" Color="#ECEDEE" />
        <SolidColorBrush x:Key="MenuTextDim" Color="#8A8F97" />
        <SolidColorBrush x:Key="MenuAccent" Color="#4C8DFF" />

        <ControlTemplate x:Key="TopMenuItem" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="9,4" Margin="1,0">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                           VerticalOffset="3" HorizontalOffset="-10"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Background="{StaticResource MenuPopup}" BorderBrush="{StaticResource MenuLine}" BorderThickness="1"
                                CornerRadius="8" Padding="4" Margin="10,2,14,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHover}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHover}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="SubMenuItem" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,6,10,6" MinWidth="240">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Check" Visibility="Collapsed" Data="M1,5 L4.5,8.5 L10,2" Stroke="{StaticResource MenuAccent}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="32,0,0,0"
                               Foreground="{StaticResource MenuTextDim}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource MenuTextDim}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template" Value="{StaticResource SubMenuItem}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopMenuItem}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{StaticResource MenuLine}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Classic Windows menu bar, dark themed -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="6,3" Background="{StaticResource MenuBar}"
              Foreground="{StaticResource MenuText}" FontFamily="Segoe UI Variable Text, Segoe UI">
            <MenuItem Header="_File">
                <MenuItem Header="_Add Folder to Library..." InputGestureText="Ctrl+O" Click="AddFolder_Click" />
                <MenuItem Header="_Import Photos from Folder..." Click="AddFolder_Click" />
                <Separator />
                <MenuItem Header="_Export Selected Photos" InputGestureText="Ctrl+E" Click="Export_Click" />
                <MenuItem Header="Export Selected _To Folder..." Click="ExportTo_Click" />
                <MenuItem Header="Create _Collage" InputGestureText="Ctrl+3" Tag="Picasa.switchTab('collage'); window.PicasaCollage &amp;&amp; PicasaCollage.renderPreview();" Click="Script_Click" />
                <Separator />
                <MenuItem Header="Back Up Library..." Click="Backup_Click" />
                <MenuItem Header="Automatic Backup Settings..." Click="BackupSettings_Click" />
                <MenuItem Header="Restore Library..." Click="Restore_Click" />
                <MenuItem Header="Open _Data Folder" Click="OpenDataFolder_Click" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Ctrl+Q" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo All Fixes" Tag="PicasaNative.undoAllFixes();" Click="Script_Click" />
                <MenuItem Header="Sa_ve Edits" Tag="PicasaNative.saveEdits();" Click="Script_Click" />
                <Separator />
                <MenuItem Header="_Star / Unstar" InputGestureText="Ctrl+S" Tag="PicasaNative.toggleStar();" Click="Script_Click" />
                <MenuItem Header="Rotate _Left" InputGestureText="Ctrl+L" Tag="PicasaNative.rotate(-90);" Click="Script_Click" />
                <MenuItem Header="Rotate _Right" InputGestureText="Ctrl+R" Tag="PicasaNative.rotate(90);" Click="Script_Click" />
                <Separator />
                <MenuItem Header="I'm _Feeling Lucky" Tag="PicasaNative.feelingLucky();" Click="Script_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Library" InputGestureText="Ctrl+1" Tag="Picasa.switchTab('library');" Click="Script_Click" />
                <MenuItem Header="_Edit Studio" InputGestureText="Ctrl+2" Tag="document.getElementById('tab-edit').click();" Click="Script_Click" />
                <MenuItem Header="_Collage" InputGestureText="Ctrl+3" Tag="Picasa.switchTab('collage');" Click="Script_Click" />
                <MenuItem Header="_Slideshow" Tag="document.getElementById('btn-slideshow-all').click();" Click="Script_Click" />
                <MenuItem Header="_Properties (EXIF)..." InputGestureText="Ctrl+I" Tag="PicasaNative.showProperties();" Click="Script_Click" />
                <Separator />
                <MenuItem x:Name="FullscreenItem" Header="_Fullscreen" InputGestureText="F11" IsCheckable="True" Click="Fullscreen_Click" />
                <Separator />
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="ZoomReset_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Luna _AI Settings..." Tag="document.getElementById('btn-open-ai-settings').click();" Click="Script_Click" />
                <MenuItem Header="Luna Auto-_Tune Current Photo" Tag="document.getElementById('action-menu-autotune').click();" Click="Script_Click" />
                <MenuItem Header="_Batch AI Tag All Photos" Tag="PicasaNative.batchTagAll();" Click="Script_Click" />
                <Separator />
                <MenuItem Header="_Rescan Library" Tag="PicasaNative.rescan();" Click="Script_Click" />
                <MenuItem Header="Re_move Current Folder from Library" Tag="PicasaNative.removeActiveFolder();" Click="Script_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Tag="document.getElementById('action-menu-help-shortcuts').click();" Click="Script_Click" />
                <MenuItem Header="_Contact Fajar Isnanto" Click="Contact_Click" />
                <MenuItem Header="_License (MIT)" Click="License_Click" />
                <Separator />
                <MenuItem Header="_About svacitra" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Grid>
            <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="#151619" />

            <!-- Shown only if the WebView2 runtime is missing -->
            <StackPanel x:Name="FallbackPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="svacitra needs the Microsoft Edge WebView2 Runtime" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="FallbackText" Foreground="#BBBBBB" FontSize="13" Margin="0,14,0,18" TextWrapping="Wrap" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Download WebView2 Runtime" Padding="14,7" Margin="6" Click="DownloadWebView2_Click" />
                    <Button Content="Open in my web browser instead" Padding="14,7" Margin="6" Click="OpenInBrowser_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
