<Window x:Class="PicasaRevive.App.BackupSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Automatic library backups" Width="510" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <CheckBox Name="EnabledBox" Content="Back up my library automatically" Margin="0,0,0,8"/>
    <TextBlock TextWrapping="Wrap" Text="Saves edits, stars, tags and folder references while svacitra is open. Keeps the latest seven automatic backups. Original photos need a separate backup."/>
    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
      <Label Content="_Every" Target="{Binding ElementName=IntervalBox}"/>
      <TextBox Name="IntervalBox" Width="66" VerticalContentAlignment="Center" Margin="6,0"/>
      <ComboBox Name="UnitBox" Width="100" SelectedIndex="0">
        <ComboBoxItem Content="minutes"/><ComboBoxItem Content="hours"/><ComboBoxItem Content="days"/>
      </ComboBox>
    </StackPanel>
    <Label Content="Backup _folder" Target="{Binding ElementName=FolderBox}" Padding="0" Margin="0,15,0,4"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Padding="8,3" Margin="8,0,0,0"/>
      <TextBox Name="FolderBox" VerticalContentAlignment="Center"/></DockPanel>
    <TextBlock Name="LastRun" TextWrapping="Wrap" Margin="0,15,0,0"/>
    <TextBlock Name="Problem" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="72" Margin="0,0,8,0"/>
      <Button Content="Save" IsDefault="True" MinWidth="72" Click="Save_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
